---
import '../styles/global.css';

const services = [
	{
		number: '01',
		title: 'Distribution automatique',
		items: [
			'Mise à disposition et installation de distributeurs automatiques.',
			'Distributeurs de boissons chaudes et froides.',
			'Machines à café professionnelles.',
			'Approvisionnement en café, thé, boissons et consommables.',
			'Entretien, suivi et gestion des équipements.',
		],
	},
	{
		number: '02',
		title: 'Fournitures et consommables professionnels',
		items: [
			'Fournitures de bureau et papeterie.',
			'Produits d’entretien et d’hygiène.',
			'Café, thé, sucre, lait et boissons.',
			'Consommables pour espaces de travail et salles de réunion.',
			'Petit équipement et accessoires professionnels.',
		],
	},
	{
		number: '03',
		title: 'Équipements et aménagement des espaces professionnels',
		items: [
			'Équipements pour cuisines et espaces de pause.',
			'Électroménager professionnel et équipements complémentaires.',
			'Mobilier de bureau et équipements collectifs.',
			'Solutions d’aménagement et d’approvisionnement.',
		],
	},
	{
		number: '04',
		title: 'Logistique et approvisionnement',
		items: [
			'Gestion des commandes et livraisons.',
			'Approvisionnement régulier ou ponctuel.',
			'Coordination des fournisseurs.',
			'Livraison sur site et gestion des besoins opérationnels.',
		],
	},
	{
		number: '05',
		title: 'Services généraux et prestations aux entreprises',
		items: [
			'Assistance aux besoins quotidiens des entreprises.',
			'Organisation et coordination de prestations.',
			'Accompagnement logistique et événementiel.',
			'Recherche et mise en relation avec des prestataires spécialisés.',
		],
	},
];

const benefits = [
	{
		title: 'Un interlocuteur unique',
		description: 'Une gestion simplifiée de vos différents besoins professionnels.',
	},
	{
		title: 'Des solutions flexibles',
		description: 'Des prestations adaptées à la taille de votre entreprise et à vos contraintes.',
	},
	{
		title: 'Réactivité et proximité',
		description:
			'Un accompagnement personnalisé et une attention particulière portée à la qualité du service.',
	},
	{
		title: 'Une approche orientée résultats',
		description:
			'Des solutions concrètes pour faciliter votre organisation et améliorer votre environnement de travail.',
	},
];
---

<!doctype html>
<html lang="fr">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>SALHANIA SOLUTIONS | Services et solutions aux entreprises</title>
		<meta
			name="description"
			content="SALHANIA SOLUTIONS accompagne les entreprises pour leurs besoins en distribution automatique, fournitures, équipements, logistique et services généraux."
		/>
		<link rel="canonical" href="https://salhania-solutions.fr/" />
		<meta name="robots" content="index, follow" />
		<meta property="og:type" content="website" />
		<meta property="og:locale" content="fr_FR" />
		<meta property="og:site_name" content="SALHANIA SOLUTIONS" />
		<meta property="og:title" content="SALHANIA SOLUTIONS | Services et solutions aux entreprises" />
		<meta
			property="og:description"
			content="Des solutions pratiques, un service fiable, un accompagnement sur mesure."
		/>
		<meta property="og:url" content="https://salhania-solutions.fr/" />
	</head>
	<body class="bg-stone-50 text-slate-900 antialiased">
		<a
			href="#contenu"
			class="sr-only z-50 rounded-md bg-white p-3 text-slate-950 focus:not-sr-only focus:fixed focus:left-4 focus:top-4"
		>
			Aller au contenu
		</a>

		<header class="border-b border-slate-200 bg-white">
			<div class="mx-auto flex max-w-7xl items-center justify-between gap-6 px-5 py-5 sm:px-8">
				<a href="/" class="text-lg font-bold tracking-tight text-slate-900" aria-label="SALHANIA SOLUTIONS, accueil">
					SALHANIA <span class="text-teal-700">SOLUTIONS</span>
				</a>
				<nav aria-label="Navigation principale" class="hidden items-center gap-8 text-sm font-medium text-slate-600 sm:flex">
					<a class="transition hover:text-teal-800" href="#services">Nos services</a>
					<a class="transition hover:text-teal-800" href="#engagements">Nos engagements</a>
					<a
						class="rounded-full bg-slate-900 px-5 py-2.5 text-white transition hover:bg-teal-800 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-teal-700"
						href="#contact"
					>
						Nous contacter
					</a>
				</nav>
				<a
					class="rounded-full bg-slate-900 px-4 py-2.5 text-sm font-medium text-white sm:hidden"
					href="#contact"
				>
					Contact
				</a>
			</div>
		</header>

		<main id="contenu">
			<section class="relative isolate overflow-hidden bg-slate-950 text-white">
				<div class="absolute inset-0 -z-10 bg-[radial-gradient(ellipse_at_top_right,_var(--tw-gradient-stops))] from-teal-800/50 via-slate-950 to-slate-950"></div>
				<div class="mx-auto max-w-7xl px-5 py-24 sm:px-8 sm:py-32 lg:py-40">
					<p class="text-sm font-semibold tracking-[0.18em] text-teal-300 uppercase">
						Business Services &amp; Supplies
					</p>
					<h1 class="mt-6 max-w-4xl text-4xl leading-tight font-semibold tracking-tight sm:text-6xl lg:text-7xl">
						Votre partenaire pour les services et solutions aux entreprises
					</h1>
					<p class="mt-7 max-w-2xl text-lg leading-8 text-slate-300 sm:text-xl">
						Des solutions pratiques, un service fiable, un accompagnement sur mesure.
					</p>
					<p class="mt-5 max-w-3xl leading-7 text-slate-300">
						SALHANIA SOLUTIONS accompagne les entreprises dans la gestion de leurs besoins opérationnels en
						proposant une gamme de services et de solutions adaptés à leur environnement professionnel.
					</p>
					<div class="mt-9 flex flex-col gap-4 sm:flex-row">
						<a
							class="inline-flex items-center justify-center rounded-full bg-teal-400 px-6 py-3 font-semibold text-slate-950 transition hover:bg-teal-300 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-teal-300"
							href="#services"
						>
							Découvrir nos services
						</a>
						<a
							class="inline-flex items-center justify-center rounded-full border border-white/30 px-6 py-3 font-semibold text-white transition hover:border-white hover:bg-white/10 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-white"
							href="mailto:contact@salhania-solutions.fr"
						>
							Parlons de vos besoins
						</a>
					</div>
				</div>
			</section>

			<section class="mx-auto max-w-7xl px-5 py-20 sm:px-8 sm:py-28">
				<div class="grid gap-8 lg:grid-cols-[0.8fr_1.2fr] lg:gap-20">
					<div>
						<p class="text-sm font-semibold tracking-[0.16em] text-teal-800 uppercase">À vos côtés</p>
						<h2 class="mt-4 text-3xl font-semibold tracking-tight text-slate-950 sm:text-4xl">
							Des solutions pour votre quotidien professionnel
						</h2>
					</div>
					<div class="space-y-5 text-lg leading-8 text-slate-600">
						<p>
							De l’approvisionnement en consommables à l’installation de distributeurs automatiques, en passant
							par la fourniture d’équipements, la logistique et les services généraux, nous mettons notre
							réactivité et notre savoir-faire au service de nos clients.
						</p>
						<p>
							Notre ambition : simplifier votre quotidien professionnel grâce à un interlocuteur unique et des
							prestations flexibles.
						</p>
					</div>
				</div>
			</section>

			<section id="services" class="scroll-mt-8 bg-white py-20 sm:py-28">
				<div class="mx-auto max-w-7xl px-5 sm:px-8">
					<div class="max-w-2xl">
						<p class="text-sm font-semibold tracking-[0.16em] text-teal-800 uppercase">Notre accompagnement</p>
						<h2 class="mt-4 text-3xl font-semibold tracking-tight text-slate-950 sm:text-4xl">Nos services</h2>
						<p class="mt-4 leading-7 text-slate-600">
							Une gamme de services et de solutions pour répondre aux besoins opérationnels des entreprises.
						</p>
					</div>
					<div class="mt-12 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
						{services.map((service) => (
							<article class="rounded-2xl border border-slate-200 bg-stone-50 p-6 sm:p-8">
								<p class="text-sm font-semibold tracking-widest text-teal-800">{service.number}</p>
								<h3 class="mt-4 text-xl leading-7 font-semibold text-slate-950">{service.title}</h3>
								<ul class="mt-5 space-y-3 text-sm leading-6 text-slate-600">
									{service.items.map((item) => (
										<li class="flex gap-3">
											<span aria-hidden="true" class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-teal-700"></span>
											<span>{item}</span>
										</li>
									))}
								</ul>
							</article>
						))}
					</div>
				</div>
			</section>

			<section id="engagements" class="scroll-mt-8 bg-stone-100 py-20 sm:py-28">
				<div class="mx-auto max-w-7xl px-5 sm:px-8">
					<div class="max-w-2xl">
						<p class="text-sm font-semibold tracking-[0.16em] text-teal-800 uppercase">Notre approche</p>
						<h2 class="mt-4 text-3xl font-semibold tracking-tight text-slate-950 sm:text-4xl">
							Pourquoi choisir SALHANIA SOLUTIONS ?
						</h2>
					</div>
					<div class="mt-12 grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
						{benefits.map((benefit) => (
							<article class="border-t-2 border-teal-700 pt-5">
								<h3 class="text-lg font-semibold text-slate-950">{benefit.title}</h3>
								<p class="mt-3 leading-7 text-slate-600">{benefit.description}</p>
							</article>
						))}
					</div>
				</div>
			</section>

			<section id="contact" class="scroll-mt-8 bg-slate-950 text-white">
				<div class="mx-auto flex max-w-7xl flex-col gap-8 px-5 py-16 sm:px-8 sm:py-20 lg:flex-row lg:items-center lg:justify-between">
					<div>
						<p class="text-sm font-semibold tracking-[0.16em] text-teal-300 uppercase">Contact</p>
						<h2 class="mt-3 text-3xl font-semibold tracking-tight sm:text-4xl">Parlons de vos besoins</h2>
						<p class="mt-4 max-w-2xl leading-7 text-slate-300">
							Pour toute demande d’information, contactez SALHANIA SOLUTIONS.
						</p>
					</div>
					<a
						class="inline-flex w-fit items-center justify-center rounded-full bg-teal-400 px-6 py-3 font-semibold text-slate-950 transition hover:bg-teal-300 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-teal-300"
						href="mailto:contact@salhania-solutions.fr"
					>
						contact@salhania-solutions.fr
					</a>
				</div>
			</section>
		</main>

		<footer class="border-t border-slate-800 bg-slate-950 text-slate-300">
			<div class="mx-auto flex max-w-7xl flex-col gap-4 px-5 py-8 text-sm sm:px-8 md:flex-row md:items-center md:justify-between">
				<p class="font-semibold text-white">SALHANIA SOLUTIONS</p>
				<p>El-Mehdi HABTI <span class="text-slate-500">·</span> Président | Founder</p>
				<a class="transition hover:text-teal-300" href="mailto:contact@salhania-solutions.fr">
					contact@salhania-solutions.fr
				</a>
			</div>
		</footer>
	</body>
</html>
